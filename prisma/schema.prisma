generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-Tenancy ───────────────────────────────────────────────────────
//
// One Tenant == one isolation scope == one ADMIN account (plus every DRIVER,
// contact, trip sheet, signature, upload and OneDrive connection beneath them).
// The SUPER_ADMIN owns the root scope and may *view* any other scope via the
// scope switcher, but never sees two scopes commingled in one query.
//
// Every scoped model carries a NOT NULL tenantId, so a row cannot physically
// exist without a scope.
//
// The `@default("")` on those columns is a TYPE-LEVEL convenience, not a real
// fallback: it lets callers omit tenantId from create payloads (the scoped client
// in lib/db-scoped.ts injects the true value at runtime) while keeping full
// Prisma type inference. An actual "" can never be persisted, because every
// tenantId is a foreign key to Tenant.id and no tenant has an empty id — the
// database rejects the row. So "no row without a valid scope" is enforced by the
// FK, not by application code.
//
// Cross-scope references are additionally blocked by composite foreign keys
// ([tenantId, id] targets), which make a row pointing into another scope
// unrepresentable rather than merely discouraged.

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  // Shown in the public driver-login company picker. The only field of a scope
  // that is ever exposed pre-authentication, and only for scopes whose owning
  // ADMIN is active.
  companyName   String?
  // The ADMIN this scope belongs to. Null for the root (SUPER_ADMIN) scope.
  ownerAdminId  String?        @unique
  createdAt     DateTime       @default(now())
  users         User[]
  admins        Admin[]
  drivers       Driver[]
  contacts      Contact[]
  tripSheets    TripSheet[]
  completedTripSheets CompletedTripSheet[]
  archivedEmailResends ArchivedEmailResend[]
  stops         Stop[]
  appConfigs    AppConfig[]
  cloudAccounts CloudAccount[]
  importedFiles ImportedFile[]
  auditLogs     AuditLog[]
  collections   Collection[]
  collectionLines CollectionLine[]
  removedStops  RemovedStop[]
  removedCollections RemovedCollection[]
  rejectedLines RejectedLine[]
  reallocatedStops ReallocatedStop[]
  invoices      Invoice[]
  creditNotes   CreditNote[]
  creditNoteLines CreditNoteLine[]
  creditNoteCollections CreditNoteCollection[]
  creditNoteAllocations CreditNoteAllocation[]
  importTemplates ImportTemplate[]
  courierTripSheets CourierTripSheet[]
  courierTripSheetInvoices CourierTripSheetInvoice[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(ADMIN)
  tenantId  String   @default("")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  driver    Driver?

  @@index([tenantId])
  @@index([email])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DRIVER
}

// ─── Accounts ─────────────────────────────────────────────────────────────

model Admin {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  // A deactivated ADMIN cannot log in. Their drivers are unaffected and keep
  // signing in and completing deliveries; see login() in lib/accounts.ts.
  active       Boolean     @default(true)
  // Retired: one session per admin. Still written (the newest login) so the
  // previous deploy keeps validating through the rollout; drop it in a later
  // migration once nothing reads it.
  sessionToken String?
  // Live sessions, oldest first, at most MAX_ADMIN_SESSIONS (lib/session.ts).
  // A new login past the cap evicts the oldest device.
  sessionTokens String[]   @default([])
  tenantId     String      @default("")
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tripSheets   TripSheet[]
  login        LoginName?

  // Composite-FK target so TripSheet.adminId cannot cross a scope boundary.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([active])
}

model Driver {
  id           String      @id @default(cuid())
  // The name trip sheets match on. Not a sign-in identifier — see LoginName.
  name         String
  // Retired: drivers sign in with a username and password. Nullable rather than
  // dropped so the previous deploy keeps working through the rollout; drop it
  // in a later migration.
  pinHash      String?
  // Null for a driver created before usernames existed. Such a driver cannot
  // sign in until an ADMIN sets a username and password on the Drivers page.
  passwordHash String?
  active       Boolean     @default(true)
  sessionToken String?
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id])
  tenantId     String      @default("")
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tripSheets   TripSheet[]
  collections  Collection[]
  login        LoginName?

  // Driver names are unique WITHIN a scope only. A global unique constraint
  // would leak another ADMIN's driver names through the duplicate-name error.
  @@unique([tenantId, name])
  // Composite-FK target so TripSheet cannot reference a driver in another scope.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([active])
}

// ─── Sign-in names ────────────────────────────────────────────────────────
//
// Every account signs in with a username and password from one form that has
// no tenant selector, so a username must identify exactly one account across
// every role and every scope.
//
// Accounts live in two tables (Admin holds SUPER_ADMIN and ADMIN, Driver holds
// DRIVER) and a UNIQUE constraint cannot span two tables. This registry is the
// one place a username exists: its primary key IS the global uniqueness
// guarantee, and login is a single lookup here. CHECK constraints in the
// migration require the stored value to be lowercase and well-formed, and each
// row to point at exactly one account.
//
// A registry like Tenant and User rather than data inside a scope: it carries
// no tenantId and is read only through UNSAFE_unscopedPrisma, under SCOPE-EXEMPT.
model LoginName {
  username  String   @id
  adminId   String?  @unique
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  driverId  String?  @unique
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Trip Sheets & Stops ──────────────────────────────────────────────────

enum TripSheetStatus {
  ACTIVE
  QUEUED
}

model TripSheet {
  id             String          @id @default(cuid())
  date           DateTime        @default(now())
  sourceFilename String
  uploadedBy     String
  driverId       String
  regNo          String?
  status         TripSheetStatus @default(ACTIVE)
  adminId        String?
  /// The import template the sheet was read with; null for the built-in
  /// layout. No foreign key: a template can be edited or deleted, and
  /// mappingSnapshot (the template as it was used) is the record of how this
  /// sheet was read.
  importTemplateId String?
  mappingSnapshot  Json?
  tenantId       String          @default("")
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  stops          Stop[]
  collections    Collection[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  driver Driver @relation(fields: [tenantId, driverId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  admin  Admin? @relation(fields: [tenantId, adminId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([driverId])
  @@index([driverId, status])
  @@index([date])
}

enum StopStatus {
  PENDING
  IN_PROGRESS
  SIGNED
}

/// Delivery-confirmation email state for one stop.
///
/// The confirmation is sent automatically the moment the customer signs, so this
/// records what became of that attempt. Anything that is not SENT is work the
/// dispatcher has to finish by hand from the dashboard, which is why "we never
/// tried", "we tried and it bounced" and "there is no address on file" are three
/// distinct states rather than one falsy emailSentAt.
///
/// SENDING is a claim held for the duration of an attempt. It is what stops the
/// automatic send and a dispatcher pressing Send at the same moment from mailing
/// the customer twice. See lib/delivery-notify.ts.
enum EmailStatus {
  NOT_SENT
  SENDING
  SENT
  FAILED
  NO_EMAIL
}

model Stop {
  id            String     @id @default(cuid())
  stopNumber    Int
  /// As printed on the trip sheet; what is displayed.
  invoiceNumber String
  /// invoiceNumber reduced to the digits every document agrees on
  /// (INV-2026-1047 → 1047, lib/invoice-number.ts) under this scope's pattern.
  /// What matching reads. Null for a stop with no invoice, and for rows written
  /// before the column existed until the backfill runs.
  invoiceNoNormalized String?
  customerName  String     @default("Unknown")
  address       String     @default("")
  nop           Int        @default(0)
  invoiceFile   String?
  status        StopStatus @default(PENDING)
  signedAt      DateTime?
  emailSentAt   DateTime?
  emailStatus   EmailStatus @default(NOT_SENT)
  emailAttempts Int         @default(0)
  emailLastAttemptAt DateTime?
  /// Why the last attempt failed, shown verbatim to the dispatcher. A bad
  /// address and a dead SMTP relay need different fixes.
  emailError    String?    @db.Text
  /// When a contact was attached to this stop AFTER it was already signed and
  /// found to have nowhere to send — i.e. the admin finally added the missing
  /// customer. Such a stop is actionable again however old the delivery is, so
  /// the dashboard exempts it from the untried-queue age bound. Null means the
  /// stop has never been rescued this way.
  emailRelinkedAt DateTime?
  signatureData String?    @db.Text
  /// The name the customer typed beside their signature. Stamped on the signed
  /// PDF and shown as "Delivered to" in the confirmation email. Null for stops
  /// signed before the field existed.
  signedByName  String?
  tripSheetId   String
  contactId     String?
  tenantId      String     @default("")
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  collections   Collection[]
  rejectedLines RejectedLine[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tripSheet TripSheet @relation(fields: [tenantId, tripSheetId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  // Restrict, not SetNull: the composite FK includes the required tenantId, so
  // SetNull would try to null a NOT NULL column. Contacts are soft-deleted
  // (deletedAt) anyway — a hard delete of a referenced contact should fail loudly.
  contact   Contact?  @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  // Composite-FK target so a Collection cannot hang off another scope's stop.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tripSheetId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([contactId])
  // The dispatcher's outstanding-email queue is read on every dashboard poll.
  @@index([tenantId, emailStatus])
  @@index([tenantId, invoiceNoNormalized])
  // Drives "signed today" reporting without scanning a scope's whole history.
  @@index([tenantId, signedAt])
}

// ─── Collections (credit returns & non-credit uplifts) ────────────────────
//
// A collection is the mirror image of a delivery: the driver takes something
// AWAY from the customer and captures a signature for it exactly as they do for
// an invoice. Collections arrive on the same trip sheet (the COLLECTNO column)
// and hang off the same customer Stop, so the driver sees one visit with two
// lists rather than two unrelated jobs at the same address.
//
// Isolation is Stop's, unchanged: composite foreign keys to [tenantId, id] on
// TripSheet, Stop and Driver make a collection that points into another scope
// unrepresentable rather than merely discouraged.
//
// Cascade from TripSheet is deliberate and mirrors Stop. Completing a trip
// deletes it, and completeTripSheet() freezes the collections into the
// CompletedTripSheet snapshot first — the signed PDFs themselves stay in the
// collections folder's Signed/ subfolder permanently and are never moved.

enum CollectionType {
  /// Creditable goods going back against an invoice already delivered.
  /// originalInvoiceNo is what accounts reconciles the credit against.
  CREDIT_RETURN
  /// Not creditable — company property, crates, paperwork, one-off requests.
  /// Requires an upliftSubtype.
  NON_CREDIT_UPLIFT
}

/// Required for NON_CREDIT_UPLIFT and meaningless for CREDIT_RETURN. Enforced
/// in lib/collections.ts, not by the database — a check constraint here would
/// have to be hand-written into the migration and is easy to drift.
enum UpliftSubtype {
  COMPANY_PARCEL
  EQUIPMENT_OR_CRATES
  DOCUMENTS
  /// Free text in Collection.notes is required alongside this one.
  SPECIAL_REQUEST
}

/// The outcome of one collection.
///
/// Four terminal states rather than a boolean, because accounts treats them
/// differently: COLLECTED and PARTIAL produce a credit (for different amounts),
/// NOT_AVAILABLE means try again another day, and REFUSED means the customer
/// declined and the credit must not be raised at all. Everything except
/// COLLECTED carries an exceptionReason.
enum CollectionStatus {
  PENDING
  COLLECTED
  PARTIAL
  NOT_AVAILABLE
  REFUSED
}

/// Whether the office's collection sheet has been read into lines.
/// MISSING: no sheet found yet (the driver can still collect against the NOP
/// count). READY: lines read and consistent with the trip sheet row.
/// NEEDS_REVIEW: read, but something disagrees — the office should look.
/// The office's decision on a credit return that came back (CR, COLLECTED or
/// PARTIAL): cleared for credit, or not creditable. Null until decided — and
/// the trip cannot be completed while any such collection is undecided.
enum CreditReview {
  APPROVED
  REJECTED
}

enum CollectionSheetStatus {
  MISSING
  READY
  NEEDS_REVIEW
}

model Collection {
  id                String           @id @default(cuid())
  /// The number on the trip sheet's COLLECTNO column. Unique per trip within a
  /// scope — the same number may legitimately recur on a later trip.
  collectionNo      String
  type              CollectionType
  upliftSubtype     UpliftSubtype?
  notes             String?          @db.Text
  /// The invoice this credit goes back against. Read off the collection
  /// document when one is matched; null when the paperwork does not carry it.
  originalInvoiceNo String?
  /// originalInvoiceNo normalized exactly as Stop.invoiceNoNormalized — the
  /// key a credit note is matched to its collection on.
  invoiceNoNormalized String?
  /// The invoice this collection is credited against: the anchor of the
  /// invoice → collection → credit note chain. Set at deploy (a stub invoice
  /// is created when the PDF is not on file). Null for an ad hoc collection or
  /// an uplift with no invoice behind it.
  invoiceId         String?
  status            CollectionStatus @default(PENDING)
  /// Required whenever status is PARTIAL, NOT_AVAILABLE or REFUSED.
  exceptionReason   String?          @db.Text
  expectedQty       Int?
  collectedQty      Int?
  /// The pending collection document, matched to collectionNo by filename the
  /// same way invoices are. Both *FilePath columns hold the FILENAME within the
  /// relevant subfolder, not an absolute path: that is the key both the OneDrive
  /// and the local reader address a file by, and an absolute path recorded on a
  /// server that has since moved would resolve to nothing.
  sourceFileId      String?
  sourceFilePath    String?
  /// The stamped output in the collections folder's Signed/ subfolder.
  signedFileId      String?
  signedFilePath    String?
  /// PNG data URL, as Stop.signatureData. Same capture component, same storage.
  /// Cleared when the trip completes, once the signed PDF holding it is filed —
  /// that PDF is the record, and this is the bulk of the row.
  signature         String?          @db.Text
  /// The signed PDF really contains the office's original pages. False when
  /// the original could not be read at signing (the receipt page stands
  /// alone), and for receipts signed before this was recorded. Only when true
  /// may the original in Pending/ be removed.
  signedIncludesSource Boolean       @default(false)
  signedByName      String?
  collectedAt       DateTime?
  /// The signed collection receipt emailed to the customer — same states and
  /// lease semantics as Stop.emailStatus (see lib/collection-notify.ts). Only
  /// COLLECTED and PARTIAL are sent: nothing changed hands on the others.
  emailStatus        EmailStatus @default(NOT_SENT)
  emailSentAt        DateTime?
  emailAttempts      Int         @default(0)
  emailLastAttemptAt DateTime?
  emailError         String?     @db.Text
  /// Who completed it. Null until the collection reaches a terminal status.
  driverId          String?
  /// The live trip and stop. BOTH null once the trip has completed: the row
  /// outlives them — a credit note arrives days later and must find it — so
  /// completion detaches it (lib/trip-data.ts completeTripSheet) before the
  /// trip is deleted. "tripSheetId is null" is what archived means. Deleting a
  /// trip any other way still cascades its (attached) collections away.
  tripSheetId       String?
  stopId            String?
  /// The stop's customer, copied onto the row so an archived collection —
  /// which has no stop left — still names who it was collected from.
  customerName      String?
  /// The CompletedTripSheet snapshot this collection was archived with. No FK:
  /// the archive is never joined to, as RemovedStop is never joined to a trip.
  completedTripSheetId String?
  tenantId          String           @default("")
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Composite FKs kept while attached, so a live collection still cannot point
  // into another scope's trip or stop. A null component switches the
  // constraint off (MATCH SIMPLE) — that is how an archived row lets go.
  tripSheet TripSheet? @relation(fields: [tenantId, tripSheetId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  stop      Stop?      @relation(fields: [tenantId, stopId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  // Restrict, not SetNull: the composite FK includes the required tenantId, so
  // SetNull would try to null a NOT NULL column. Same reasoning as Stop.contact.
  driver    Driver?   @relation(fields: [tenantId, driverId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  // Restrict for the same reason as driver: an invoice is a durable anchor and
  // is never deleted while anything points at it.
  invoice   Invoice?  @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  // ── The office's collection sheet, read into lines (lib/collection-sheet.ts)
  sheetStatus       CollectionSheetStatus @default(MISSING)
  /// What disagreed on the last read — shown to the office. [{code, message}]
  sheetIssues       Json?
  /// The sheet's own header as read (collection no, invoice no, customer,
  /// date, account) — what the office compares against the trip sheet row.
  sheetHeader       Json?
  /// TEXT (the PDF's text layer, by position) or AI (a scan read by Claude).
  sheetSource       String?
  sheetReadAt       DateTime?
  /// The document's last-modified time when it was read: a sheet re-saved by
  /// the office before the trip starts is read again.
  sheetFileModified DateTime?
  /// Last look for a sheet, read or not — throttles the re-checks.
  sheetCheckedAt    DateTime?
  sheetError        String?   @db.Text
  sheetReviewedBy   String?
  sheetReviewedAt   DateTime?
  lines             CollectionLine[]
  creditNoteLinks   CreditNoteCollection[]
  /// The driver chose "Not as listed": what came back differs from the sheet.
  hasVariance       Boolean   @default(false)
  /// Why a collection failed: CUSTOMER_NOT_READY · GOODS_NOT_AVAILABLE ·
  /// CUSTOMER_REFUSED · OTHER. The status (NOT_AVAILABLE / REFUSED) says what
  /// accounts does about it; this says what happened at the door.
  failReason        String?

  // ── The office's decision on a credit return (lib/collection-review.ts) ──
  /// Only a CR (credit return against an invoice) that came back needs one.
  /// REJECTED: kept on record, never matched to a credit note.
  creditReview       CreditReview?
  creditReviewReason String?   @db.Text
  creditReviewedBy   String?
  creditReviewedAt   DateTime?

  @@unique([tenantId, tripSheetId, collectionNo])
  @@index([tenantId])
  @@index([tripSheetId])
  @@index([stopId])
  @@index([tenantId, status])
  // Drives the credit-return report: type + date range, without scanning a
  // scope's whole collection history.
  @@index([tenantId, type, collectedAt])
  @@index([tenantId, invoiceNoNormalized])
  @@index([tenantId, completedTripSheetId])
  // Composite-FK target, so a CollectionLine cannot hang off another scope's collection.
  @@unique([tenantId, id])
}

/// One line of the office's collection sheet — what the driver is expected to
/// bring back. Read off the sheet, never typed by the driver: the sheet is the
/// source of truth, and the driver records only differences (step 5).
model CollectionLine {
  id           String   @id @default(cuid())
  tenantId     String   @default("")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  collectionId String
  /// Position on the sheet, 1-based, across pages.
  lineNo       Int
  /// The sheet's "Product no".
  itemCode     String?
  /// The unlabelled short-name column between Product no and Description.
  shortName    String?
  description  String
  /// The sheet's Qty: the count the office expects back.
  qtyListed    Int
  /// The sheet's Returned column as printed — 0 on the office's copy. What
  /// the driver actually collects is qtyCollected.
  qtyReturnedPrinted Int?
  /// What the driver brought back — set at the door. "Collected as listed"
  /// sets it to qtyListed on every line; "Not as listed" records the counts.
  qtyCollected Int?
  /// Why it differs from the sheet: SHORT · DAMAGED · NOT_AVAILABLE ·
  /// CUSTOMER_KEPT · OTHER (lib/collection-confirm.ts). Required when fewer
  /// came back; allowed on a full count (goods back, but damaged).
  diffReason   String?
  diffNote     String?   @db.Text
  /// Handed over but not on the sheet — added by the driver (qtyListed 0).
  isExtra      Boolean   @default(false)
  /// The sheet's Reason cell, as printed (a code on the client's sheet).
  reasonCode   String?
  /// Credit return or non-credit uplift. The sheet has no Type column: a sheet
  /// that names an invoice is a credit return against it; one with no invoice
  /// (or a row the trip sheet marks as an uplift) is crates, parcels or
  /// documents — never matched to a credit note.
  type         CollectionType @default(CREDIT_RETURN)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [tenantId, collectionId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, collectionId, lineNo])
  @@index([tenantId, collectionId])
}

// ─── Completed Trip Sheets (archive) ──────────────────────────────────────
//
// Completing a trip sheet deletes it: the stops are done, the source file moves
// to processed/, and leaving the rows behind would keep them in every driver's
// run sheet and in the change-feed cursor. That made the day's work vanish the
// moment it was closed out, so a flat snapshot is written here first.
//
// This is an archive, not live data. Nothing joins to it and nothing updates it
// — the stop list is frozen as JSON at completion time precisely so that later
// edits to drivers or contacts cannot rewrite what was delivered.

model CompletedTripSheet {
  id             String   @id @default(cuid())
  /// The id the trip sheet had before it was deleted. For cross-referencing an
  /// audit-log entry only; there is no row left to point at.
  tripSheetId    String
  driverId       String
  driverName     String
  regNo          String?
  sourceFilename String
  /// Where the source file landed in processed/, or null if the move failed.
  archivedFile   String?
  uploadedAt     DateTime
  uploadedBy     String
  completedAt    DateTime @default(now())
  completedBy    String?
  totalStops     Int
  signedStops    Int
  totalCollections Int    @default(0)
  collectedCollections Int @default(0)
  /// Frozen array of { stopNumber, invoiceNumber, customerName, address, nop,
  /// signedAt, emailStatus }.
  stops          Json
  /// Frozen array of the trip's collections — see ArchivedCollection in
  /// lib/trip-data.ts. Nullable because rows archived before collections
  /// existed have none; readers treat null as [].
  ///
  /// This is the whole record once the trip is closed: the Collection rows
  /// cascade away with the trip sheet, so signedFilePath here is what the
  /// archive view and the credit-return report read.
  collections    Json?
  tenantId       String   @default("")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  createdAt      DateTime @default(now())
  emailResends   ArchivedEmailResend[]

  // Composite-FK target so a resend cannot point at another scope's archive.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, completedAt])
  @@index([tenantId, driverId])
}

/// A delivery confirmation resent from the completed-trip archive.
///
/// The archive itself is frozen — nothing updates CompletedTripSheet — so the
/// resends live here instead. This table is also the resend BUDGET: `attempt`
/// is unique per archived stop and CHECK-constrained to 1..3, so a fourth
/// resend is unrepresentable rather than merely refused, and two dispatchers
/// clicking at once cannot both take the last slot.
///
/// A row with `sentAt` null is an attempt in flight. A failed send deletes its
/// row, so a dead mail relay never uses up a customer's resends; a crashed
/// attempt's row is cleared once stale (see lib/archive-resend.ts).
model ArchivedEmailResend {
  id                   String    @id @default(cuid())
  completedTripSheetId String
  /// The archived stop, by its number within the sheet.
  stopNumber           Int
  attempt              Int
  recipient            String
  sentAt               DateTime?
  sentBy               String?
  tenantId             String    @default("")
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  createdAt            DateTime  @default(now())

  completedTripSheet CompletedTripSheet @relation(fields: [tenantId, completedTripSheetId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, completedTripSheetId, stopNumber, attempt])
  @@index([tenantId, completedTripSheetId])
}

// ─── App Configuration ────────────────────────────────────────────────────
//
// Per-scope key/value config. Invoice folder, trip sheet folder and signature
// position are settings of ONE admin, not of the installation.

// ─── Invoices (durable registry) ──────────────────────────────────────────
//
// Invoices themselves are PDFs in the scope's invoice folder, and the Stop that
// delivered one is deleted when its trip completes. This is the record that
// outlives both: one row per invoice NUMBER, the anchor every collection and
// credit note hangs off. Filled from the folder listing, deploys and uploads —
// never by a parse of the PDF's line items.

model Invoice {
  id                  String    @id @default(cuid())
  tenantId            String    @default("")
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  /// As first seen (file stem or sheet cell). Display only.
  invoiceNo           String
  /// What everything matches on — see lib/invoice-number.ts. Numbers run on
  /// across years, so this is unique per scope.
  invoiceNoNormalized String
  /// The file in the invoice folder. Null for a stub, or once the file is deleted.
  pdfFilename         String?
  /// Created from a collection row whose invoice PDF was not on file — an
  /// invoice delivered before Signex, say. Cleared when the PDF turns up.
  isStub              Boolean   @default(false)
  /// The trip sheet's CUSTOMER — the value shown. The latest sheet wins.
  customerName        String?
  /// Read off the PDF header, for the cross-check. On a cash sale "Invoice to"
  /// is the cash account and "Deliver to" is the real customer.
  deliverToName       String?
  billToName          String?
  /// The invoice's own date, from the PDF. Never the trip sheet's Date, which
  /// is the day of the trip.
  invoiceDate         DateTime? @db.Date
  /// TEXT (PDF text layer), AI (scanned PDF read by Claude) or MANUAL. Null
  /// until the header has been read; a read header is never re-read.
  headerSource        String?
  headerAttempts      Int       @default(0)
  headerError         String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  collections Collection[]
  creditNotes CreditNote[]
  courierInvoices CourierTripSheetInvoice[]

  @@unique([tenantId, invoiceNoNormalized])
  // Composite-FK target, as Stop's.
  @@unique([tenantId, id])
  @@index([tenantId, invoiceDate])
  @@index([tenantId, customerName])
  @@index([tenantId, headerSource])
}

model AppConfig {
  tenantId  String   @default("")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([tenantId, key])
  @@index([tenantId])
}

// ─── Cloud Accounts (OneDrive / Google Drive OAuth) ───────────────────────
//
// One connection PER SCOPE per provider. accessToken and refreshToken are
// stored encrypted at rest (AES-256-GCM, see lib/crypto.ts) — the column type
// holds ciphertext, never a usable bearer token.

model CloudAccount {
  id                  String   @id @default(cuid())
  tenantId            String   @default("")
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  provider            String // "onedrive" | "gdrive"
  accountEmail        String?
  accountName         String?
  accessToken         String   @db.Text // encrypted
  refreshToken        String   @db.Text // encrypted
  tokenExpiry         DateTime
  driveId             String?
  folderPath          String? // trip sheet folder
  folderItemId        String? // trip sheet folder item ID
  invoiceFolderPath   String?
  invoiceFolderItemId String?
  // Collections live in a SIBLING folder of the invoices folder, never inside
  // it: the invoice listing and the collections listing must not see each
  // other's documents. lib/collections.ts rejects a nested configuration.
  collectionsFolderPath   String?
  collectionsFolderItemId String?
  // Credit notes: the folder the accounting software writes this branch's
  // credit notes to, with flat Originals/ Signed/ Rejected/ beneath it. Not
  // inside (or around) the invoice or collections folder — every listing here
  // is extension-based. See lib/credit-intake.ts.
  creditsFolderPath   String?
  creditsFolderItemId String?
  /// Last look at the credits folder — throttles the automatic check.
  creditsCheckedAt    DateTime?
  /// Why the last look failed, for the Credits page. Null when it worked.
  creditsError        String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
}

// ─── Import Templates (column mapping) ────────────────────────────────────
//
// An ADMIN's description of their own spreadsheet layout: which worksheet,
// which row holds the headers, and which column or cell each Signex field
// comes from. Read by lib/sheet-mapping.ts; stored and chosen by
// lib/sheet-templates.ts. The layout trip sheets have always used is NOT a row
// here — it is BUILT_IN_TRIP_SHEET, defined in code.

enum ImportSheetType {
  TRIP_SHEET
  COURIER_TRIP_SHEET
}

model ImportTemplate {
  id                String          @id @default(cuid())
  tenantId          String          @default("")
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  sheetType         ImportSheetType
  name              String
  /// At most one default per scope and sheet type. Kept so by
  /// lib/sheet-templates.ts in one transaction rather than by a partial unique
  /// index, which the schema cannot express — a hand-written one would read as
  /// drift and the next generated migration would drop it.
  isDefault         Boolean         @default(false)
  /// null reads the first worksheet.
  worksheet         String?
  headerRow         Int
  dataStartRow      Int
  stopAtBlankRows   Int             @default(2)
  /// The sample file's header row, normalised and joined — how an upload is
  /// recognised as this layout. See headerFingerprint().
  headerFingerprint String
  /// Field key → FieldMapping (lib/sheet-mapping.ts). Validated on write.
  mappings          Json
  /// Who saved it. Not a foreign key: a SUPER_ADMIN viewing this scope is not
  /// one of its admins, and the template outlives the account.
  createdById       String
  createdByName     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([tenantId, sheetType, name])
  @@unique([tenantId, id])
  @@index([tenantId, sheetType])
}

// ─── Courier Trip Sheets ──────────────────────────────────────────────────
//
// Invoices that leave by courier rather than with one of our drivers. The
// client's Trip application exports one sheet per customer (Excel, sheet
// number in the filename: cts-200189-p5.xlsx); the dispatcher has the courier
// driver sign for every invoice on it at once, and the customer confirms
// receipt from an emailed link. See lib/courier-import.ts.
//
// Never deployed to a DRIVER. Signed copies go to the existing signed-invoice
// location under the existing names; the only new folder is Courier Trip
// Sheets/ (beside Trip Sheets/) for the original Excel files.

enum CourierStatus {
  /// Something blocks the handover — see `issues` (level "block").
  NEEDS_ATTENTION
  AWAITING_COLLECTION
  /// The courier driver signed for the goods.
  COLLECTED
  /// The customer confirmed receipt.
  DELIVERED
}

model CourierTripSheet {
  id               String        @id @default(cuid())
  tenantId         String        @default("")
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  /// From the filename (cts-200189-p5 → 200189). Unique per scope.
  courierSheetNo   String
  sheetDate        DateTime      @db.Date
  /// Not in the client's export; typed at import or at signing.
  courierCompany   String?
  courierService   String?
  courierContact   String?
  /// One customer per sheet — a sheet naming two is refused at import.
  customerName     String
  contactId        String?
  /// Copied from the contact when linked; null when it has no email.
  customerEmail    String?
  /// Consignment total: per waybill, the one value the sheet fills in.
  parcels          Int?
  /// Distinct waybills in sheet order — several are allowed (client decision).
  waybills         String[]      @default([])
  status           CourierStatus @default(AWAITING_COLLECTION)
  /// [{ code, level: "block" | "warning", invoiceNo?, message }]. A "block"
  /// holds the sheet in NEEDS_ATTENTION; a missing email is only a warning
  /// (client decision: the handover goes ahead, the email waits).
  issues           Json?
  checkedAt        DateTime?
  /// As uploaded.
  sourceFileName   String
  /// Where the original was kept: OneDrive item id, and the path for display.
  sourceFileId     String?
  sourceFilePath   String?
  /// The original's bytes, held only until they are stored (for Retry) —
  /// a few KB, cleared once filed.
  sourceFileBytes  Bytes?
  sourceFileError  String?       @db.Text
  importTemplateId String?
  mappingSnapshot  Json?
  importedById     String
  importedByName   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  invoices CourierTripSheetInvoice[]
  // Restrict, as Stop's: the composite FK includes the required tenantId.
  contact  Contact? @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, courierSheetNo])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, sheetDate])
}

model CourierTripSheetInvoice {
  id                  String    @id @default(cuid())
  tenantId            String    @default("")
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  courierSheetId      String
  /// Order on the sheet.
  lineNo              Int
  /// As printed on the sheet; display only.
  invoiceNo           String
  invoiceNoNormalized String?
  invoiceId           String?
  /// The PDF in the invoice folder, when found.
  invoiceFile         String?
  invoiceDate         DateTime? @db.Date
  waybillNo           String
  /// As the sheet wrote it on this row; often only on a waybill's first row.
  parcels             Int?
  createdAt           DateTime  @default(now())

  courierSheet CourierTripSheet @relation(fields: [tenantId, courierSheetId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  invoice      Invoice?         @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, courierSheetId, lineNo])
  @@index([tenantId, invoiceNoNormalized])
  @@index([courierSheetId])
}

// ─── Imported Files (Trip Sheet Cloud Folder Tracking) ────────────────────

model ImportedFile {
  id          String   @id @default(cuid())
  tenantId    String   @default("")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  filename    String
  folderPath  String
  importedAt  DateTime @default(now())
  tripSheetId String?
  status      String   @default("imported") // imported | failed | skipped

  // Scoped uniqueness — one ADMIN importing "route.csv" must not mark it
  // consumed for every other ADMIN.
  @@unique([tenantId, filename])
  @@index([tenantId])
  @@index([filename])
  @@index([importedAt])
}

// ─── Audit Log ────────────────────────────────────────────────────────────

enum AuditAction {
  UPLOAD
  SIGN
  LOGIN
  LOGOUT
  STATUS_CHANGE
  DRIVER_CREATE
  DRIVER_UPDATE
  DRIVER_DELETE
  CONFIG_UPDATE
  SCOPE_SWITCH
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  entity    String // trip_sheet | stop | driver | admin | config | scope
  entityId  String?
  userName  String?
  details   String?     @db.Text
  // Nullable by design: failed logins and other pre-session events have no
  // scope yet. Everything post-authentication MUST set it.
  tenantId  String?
  tenant    Tenant?     @relation(fields: [tenantId], references: [id])
  createdAt DateTime    @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([tenantId, createdAt])
}

// ─── Contacts ─────────────────────────────────────────────────────────────

enum ContactSource {
  MANUAL
  SPREADSHEET
  AUTO_CREATED
}

model Contact {
  id            String        @id @default(cuid())
  tenantId      String        @default("")
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  companyName   String
  contactPerson String?
  email         String?
  phone         String?
  altPhone      String?
  address       String?
  notes         String?
  source        ContactSource @default(MANUAL)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  stops         Stop[]
  courierTripSheets CourierTripSheet[]

  // Composite-FK target so a Stop cannot reference a contact in another scope.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, companyName])
  @@index([tenantId, email])
  @@index([deletedAt])
}

/// An invoice taken off a live trip sheet before it was signed — the customer
/// rejected the delivery (wrong item sent), or the dispatcher deleted the
/// invoice PDF from the Invoices page while it was still on a run.
///
/// Frozen, like CompletedTripSheet: the Stop row is gone (or, if the stop also
/// carried collections, stripped of its delivery), so this is the only record
/// that the invoice was ever on the run and why it came off. Deliberately no
/// foreign key to TripSheet — the record must outlive the sheet, which is
/// deleted when it is completed. The trip sheet page and the completed archive
/// both find these by tripSheetId.
model RemovedStop {
  id                 String   @id @default(cuid())
  tripSheetId        String
  driverId           String
  driverName         String
  stopNumber         Int
  invoiceNumber      String
  customerName       String
  address            String   @default("")
  nop                Int      @default(0)
  invoiceFile        String?
  /// The stop's status when it came off (PENDING / IN_PROGRESS). Never SIGNED:
  /// a signed delivery cannot be removed.
  statusAtRemoval    String
  /// REJECTED (taken off on the Trip Sheet page) or INVOICE_DELETED (its PDF
  /// was deleted on the Invoices page).
  source             String
  reason             String   @db.Text
  removedBy          String
  /// True when the stop stayed on the run for its collections and only the
  /// delivery came off.
  keptForCollections Boolean  @default(false)
  removedAt          DateTime @default(now())
  tenantId           String   @default("")
  tenant             Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, tripSheetId])
  @@index([tenantId, removedAt])
}

/// A collection the office took off a live run before the driver got to it —
/// the customer rang to say not to collect. Written in the same transaction as
/// the delete, and frozen like RemovedStop: deliberately no FK to TripSheet, so
/// it outlives the run (completion deletes the sheet). Not cascaded by
/// anything — the admin-workspace purge deletes it explicitly.
model RemovedCollection {
  id                String   @id @default(cuid())
  tripSheetId       String
  driverId          String
  driverName        String
  stopNumber        Int
  collectionNo      String
  type              String
  customerName      String
  originalInvoiceNo String?
  /// The box count from the trip sheet.
  expectedQty       Int?
  /// Lines read off the office's sheet, if it had been read.
  lineCount         Int      @default(0)
  /// The stop had nothing else on it, so it came off the run too.
  stopRemoved       Boolean  @default(false)
  reason            String   @db.Text
  removedBy         String
  removedAt         DateTime @default(now())
  tenantId          String   @default("")
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, tripSheetId])
  @@index([tenantId, removedAt])
}

/// One line of an invoice the customer refused at the door while accepting the
/// rest. Signex holds invoices as PDFs, not line items, so this is the
/// dispatcher's description of the line — what accounts raises the credit note
/// against. It is shown to the driver, printed on a "Delivery exceptions" page
/// appended to the signed PDF, and listed in the confirmation email.
///
/// Composite FK to [tenantId, id] on Stop: a rejected line cannot hang off
/// another scope's stop, and it goes with its stop.
model RejectedLine {
  id          String   @id @default(cuid())
  stopId      String
  description String
  /// Units refused. Null when no count was given.
  quantity    Int?
  reason      String
  recordedBy  String
  createdAt   DateTime @default(now())
  tenantId    String   @default("")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  stop Stop @relation(fields: [tenantId, stopId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId])
  @@index([stopId])
}

/// A stop moved from one driver's live run to another's — the first driver
/// did not finish yesterday, or is absent today. The Stop row itself moves
/// (its tripSheetId changes, with its collections and rejected lines); this is
/// the record that it did, read from both ends: the original run shows what
/// left it and to whom, the receiving run shows where its stops came from.
///
/// Like RemovedStop, deliberately no FK to either TripSheet: both are deleted
/// when completed, and this record must outlive them. The original run can be
/// completed once whatever is left on it is signed, even if nothing is.
model ReallocatedStop {
  id              String   @id @default(cuid())
  fromTripSheetId String
  toTripSheetId   String
  fromDriverId    String
  fromDriverName  String
  toDriverId      String
  toDriverName    String
  /// The stop's number on the original run, and on the new one.
  fromStopNumber  Int
  toStopNumber    Int
  /// Blank for a collection-only stop.
  invoiceNumber   String
  customerName    String
  reason          String?
  reallocatedBy   String
  reallocatedAt   DateTime @default(now())
  tenantId        String   @default("")
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, fromTripSheetId])
  @@index([tenantId, toTripSheetId])
}

// ─── Credit notes (lib/credit-note.ts, lib/credit-intake.ts) ─────────────

/// RECEIVED: read, nothing for the office to look at. NEEDS_REVIEW: read,
/// but something disagrees (shown as issues). SIGNED: signed off by the
/// office and filed in Signed/. REJECTED: not this branch's to sign — a
/// duplicate credit number, say — and moved to Rejected/.
enum CreditNoteStatus {
  RECEIVED
  NEEDS_REVIEW
  SIGNED
  REJECTED
}

/// A credit note from the accounting software, read off its PDF in the
/// branch's credits folder. Matched to the invoice it credits (the note never
/// prints a collection number) and through that invoice to the collections
/// whose goods it pays for.
model CreditNote {
  id                  String   @id @default(cuid())
  tenantId            String   @default("")
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  /// As printed ("CR NOTE 407712"). Null when it could not be read.
  creditNo            String?
  /// The digits of creditNo. NOT unique: a duplicate is kept, as REJECTED.
  creditNoNormalized  String?
  /// creditNoNormalized while the note is live, null once it is rejected.
  /// Its unique index is what makes two live notes with one number
  /// impossible, even when two copies are picked up at the same moment.
  creditNoClaim       String?
  /// The invoice credited, as printed ("Inv No. 384281").
  invoiceNo           String?
  invoiceNoNormalized String?
  /// The registry row for that invoice. Null when Signex has never seen it.
  invoiceId           String?
  /// The note's own date — its "Invoice date" box, not the Order date.
  creditDate          DateTime? @db.Date
  accountNo           String?
  deliverToName       String?
  billToName          String?
  subtotal            Decimal? @db.Decimal(12, 2)
  vatAmount           Decimal? @db.Decimal(12, 2)
  total               Decimal? @db.Decimal(12, 2)
  status              CreditNoteStatus @default(RECEIVED)
  /// What the last check found: [{code, level, message}].
  issues              Json?
  /// TEXT (the PDF text layer, by position) or AI (a scan read by Claude).
  readSource          String?
  readAt              DateTime?
  readError           String?  @db.Text
  rejectReason        String?  @db.Text
  /// The file. The OneDrive item id follows it through moves between
  /// subfolders; the name is for display and for the signed copy's name.
  sourceItemId        String
  sourceFilename      String
  /// Where the file sits now: Originals, root (dropped straight into the
  /// credits folder), Rejected or Signed.
  sourceFolder        String
  /// The file's last-modified time when read: a re-saved note is read again.
  sourceModifiedAt    DateTime?
  /// A move between subfolders that failed — the row is right, the folder is not.
  fileError           String?  @db.Text
  /// Who uploaded it through Signex. Null when it was picked up from the folder.
  uploadedBy          String?

  // ── Sign-off (lib/credit-signoff.ts) ──
  /// The name the dispatcher typed.
  signedByName        String?
  /// The office login that signed — the session's name, not something typed.
  signedByLogin       String?
  signedByUserId      String?
  signedAt            DateTime?
  /// PNG data URL of the drawn signature. Cleared once the signed copy is
  /// filed: that PDF is the record. Kept while filing has not succeeded, so
  /// a retry can still build it.
  signature           String?  @db.Text
  /// The issues the dispatcher saw and accepted when signing, and why.
  acknowledgedIssues  Json?
  acknowledgement     String?  @db.Text
  /// The signed copy in Signed/ (original pages + the sign-off page).
  signedFileId        String?
  signedFilename      String?
  filedAt             DateTime?
  /// Why filing (or removing the original) did not finish — the signature
  /// stands either way; the office can retry.
  filingError         String?  @db.Text
  /// The signed copy really contains the original's pages. Only then may the
  /// original be removed (as Collection.signedIncludesSource).
  signedIncludesSource Boolean @default(false)
  /// The unsigned original was removed from Originals/ after filing.
  originalRemoved     Boolean  @default(false)
  rejectedBy          String?
  rejectedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Restrict, as Collection.invoice: an invoice is a durable anchor.
  invoice     Invoice?               @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  lines       CreditNoteLine[]
  collections CreditNoteCollection[]
  allocations CreditNoteAllocation[]

  @@unique([tenantId, sourceItemId])
  @@unique([tenantId, creditNoClaim])
  // Composite-FK target, so a line or link cannot hang off another scope's note.
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, invoiceNoNormalized])
  @@index([tenantId, creditDate])
}

/// One line of a credit note, as printed. Quantities are what a credit is
/// matched on; amounts are only checked against the note's own totals (returns
/// carry a handling charge, so a credit never equals the invoice's price).
model CreditNoteLine {
  id           String   @id @default(cuid())
  tenantId     String   @default("")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  creditNoteId String
  /// Position on the note, 1-based, across pages.
  lineNo       Int
  /// "Product no" — the same code the collection sheet prints.
  productCode  String?
  /// The unlabelled short-name column after Product no.
  shortName    String?
  bin          String?
  description  String
  qty          Decimal  @db.Decimal(12, 3)
  unitPrice    Decimal? @db.Decimal(12, 2)
  discountPct  Decimal? @db.Decimal(6, 2)
  nett         Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  creditNote CreditNote @relation(fields: [tenantId, creditNoteId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, creditNoteId, lineNo])
  @@index([tenantId, creditNoteId])
}

/// Which collections a credit note pays for. AUTO: found through the
/// invoice. MANUAL: linked by the office. EXCLUDED: an AUTO link the office
/// took away, kept so the next automatic check does not put it back.
model CreditNoteCollection {
  id           String   @id @default(cuid())
  tenantId     String   @default("")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  creditNoteId String
  collectionId String
  source       String
  linkedBy     String?
  /// The collection's signed receipt got this note's reference page appended.
  /// Set once, so a retried filing never appends it twice.
  receiptStampedAt DateTime?
  createdAt    DateTime @default(now())

  creditNote CreditNote @relation(fields: [tenantId, creditNoteId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  // Cascade: a collection deleted with its live trip takes its links with it.
  // Completion detaches collections rather than deleting them, so the usual
  // path keeps every link.
  collection Collection @relation(fields: [tenantId, collectionId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, creditNoteId, collectionId])
  @@index([tenantId, collectionId])
}

/// What a SIGNED credit note paid for, frozen at signing: so many of this
/// collected line. A later note matches against what is left. No FK to the
/// collection line — like RemovedStop, a record outlives what it describes.
model CreditNoteAllocation {
  id               String   @id @default(cuid())
  tenantId         String   @default("")
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  creditNoteId     String
  /// The credit note line it came from.
  lineNo           Int
  collectionId     String
  collectionLineId String
  collectionNo     String
  itemCode         String?
  qty              Decimal  @db.Decimal(12, 3)
  createdAt        DateTime @default(now())

  creditNote CreditNote @relation(fields: [tenantId, creditNoteId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, creditNoteId])
  @@index([tenantId, collectionLineId])
  @@index([tenantId, collectionId])
}
