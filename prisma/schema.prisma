generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-Tenancy ───────────────────────────────────────────────────────
//
// One Tenant == one isolation scope == one ADMIN account (plus every DRIVER,
// contact, trip sheet, signature, upload and OneDrive connection beneath them).
// The SUPER_ADMIN owns the root scope and may *view* any other scope via the
// scope switcher, but never sees two scopes commingled in one query.
//
// Every scoped model carries a NOT NULL tenantId, so a row cannot physically
// exist without a scope.
//
// The `@default("")` on those columns is a TYPE-LEVEL convenience, not a real
// fallback: it lets callers omit tenantId from create payloads (the scoped client
// in lib/db-scoped.ts injects the true value at runtime) while keeping full
// Prisma type inference. An actual "" can never be persisted, because every
// tenantId is a foreign key to Tenant.id and no tenant has an empty id — the
// database rejects the row. So "no row without a valid scope" is enforced by the
// FK, not by application code.
//
// Cross-scope references are additionally blocked by composite foreign keys
// ([tenantId, id] targets), which make a row pointing into another scope
// unrepresentable rather than merely discouraged.

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  // Shown in the public driver-login company picker. The only field of a scope
  // that is ever exposed pre-authentication, and only for scopes whose owning
  // ADMIN is active.
  companyName   String?
  // The ADMIN this scope belongs to. Null for the root (SUPER_ADMIN) scope.
  ownerAdminId  String?        @unique
  createdAt     DateTime       @default(now())
  users         User[]
  admins        Admin[]
  drivers       Driver[]
  contacts      Contact[]
  tripSheets    TripSheet[]
  completedTripSheets CompletedTripSheet[]
  stops         Stop[]
  appConfigs    AppConfig[]
  cloudAccounts CloudAccount[]
  importedFiles ImportedFile[]
  auditLogs     AuditLog[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(ADMIN)
  tenantId  String   @default("")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  driver    Driver?

  @@index([tenantId])
  @@index([email])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DRIVER
}

// ─── Accounts ─────────────────────────────────────────────────────────────

model Admin {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  // A deactivated ADMIN cannot log in. Their drivers are unaffected and keep
  // signing in and completing deliveries; see loginAdmin / loginDriver.
  active       Boolean     @default(true)
  sessionToken String?
  tenantId     String      @default("")
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tripSheets   TripSheet[]

  // Composite-FK target so TripSheet.adminId cannot cross a scope boundary.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([active])
}

model Driver {
  id           String      @id @default(cuid())
  name         String
  pinHash      String
  active       Boolean     @default(true)
  sessionToken String?
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id])
  tenantId     String      @default("")
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tripSheets   TripSheet[]

  // Driver names are unique WITHIN a scope only. A global unique constraint
  // would leak another ADMIN's driver names through the duplicate-name error.
  @@unique([tenantId, name])
  // Composite-FK target so TripSheet cannot reference a driver in another scope.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([active])
}

// ─── Trip Sheets & Stops ──────────────────────────────────────────────────

enum TripSheetStatus {
  ACTIVE
  QUEUED
}

model TripSheet {
  id             String          @id @default(cuid())
  date           DateTime        @default(now())
  sourceFilename String
  uploadedBy     String
  driverId       String
  regNo          String?
  status         TripSheetStatus @default(ACTIVE)
  adminId        String?
  tenantId       String          @default("")
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  stops          Stop[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  driver Driver @relation(fields: [tenantId, driverId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  admin  Admin? @relation(fields: [tenantId, adminId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([driverId])
  @@index([driverId, status])
  @@index([date])
}

enum StopStatus {
  PENDING
  IN_PROGRESS
  SIGNED
}

/// Delivery-confirmation email state for one stop.
///
/// The confirmation is sent automatically the moment the customer signs, so this
/// records what became of that attempt. Anything that is not SENT is work the
/// dispatcher has to finish by hand from the dashboard, which is why "we never
/// tried", "we tried and it bounced" and "there is no address on file" are three
/// distinct states rather than one falsy emailSentAt.
///
/// SENDING is a claim held for the duration of an attempt. It is what stops the
/// automatic send and a dispatcher pressing Send at the same moment from mailing
/// the customer twice. See lib/delivery-notify.ts.
enum EmailStatus {
  NOT_SENT
  SENDING
  SENT
  FAILED
  NO_EMAIL
}

model Stop {
  id            String     @id @default(cuid())
  stopNumber    Int
  invoiceNumber String
  customerName  String     @default("Unknown")
  address       String     @default("")
  nop           Int        @default(0)
  invoiceFile   String?
  status        StopStatus @default(PENDING)
  signedAt      DateTime?
  emailSentAt   DateTime?
  emailStatus   EmailStatus @default(NOT_SENT)
  emailAttempts Int         @default(0)
  emailLastAttemptAt DateTime?
  /// Why the last attempt failed, shown verbatim to the dispatcher. A bad
  /// address and a dead SMTP relay need different fixes.
  emailError    String?    @db.Text
  signatureData String?    @db.Text
  tripSheetId   String
  contactId     String?
  tenantId      String     @default("")
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tripSheet TripSheet @relation(fields: [tenantId, tripSheetId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  // Restrict, not SetNull: the composite FK includes the required tenantId, so
  // SetNull would try to null a NOT NULL column. Contacts are soft-deleted
  // (deletedAt) anyway — a hard delete of a referenced contact should fail loudly.
  contact   Contact?  @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId])
  @@index([tripSheetId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([contactId])
  // The dispatcher's outstanding-email queue is read on every dashboard poll.
  @@index([tenantId, emailStatus])
  // Drives "signed today" reporting without scanning a scope's whole history.
  @@index([tenantId, signedAt])
}

// ─── Completed Trip Sheets (archive) ──────────────────────────────────────
//
// Completing a trip sheet deletes it: the stops are done, the source file moves
// to processed/, and leaving the rows behind would keep them in every driver's
// run sheet and in the change-feed cursor. That made the day's work vanish the
// moment it was closed out, so a flat snapshot is written here first.
//
// This is an archive, not live data. Nothing joins to it and nothing updates it
// — the stop list is frozen as JSON at completion time precisely so that later
// edits to drivers or contacts cannot rewrite what was delivered.

model CompletedTripSheet {
  id             String   @id @default(cuid())
  /// The id the trip sheet had before it was deleted. For cross-referencing an
  /// audit-log entry only; there is no row left to point at.
  tripSheetId    String
  driverId       String
  driverName     String
  regNo          String?
  sourceFilename String
  /// Where the source file landed in processed/, or null if the move failed.
  archivedFile   String?
  uploadedAt     DateTime
  uploadedBy     String
  completedAt    DateTime @default(now())
  completedBy    String?
  totalStops     Int
  signedStops    Int
  /// Frozen array of { stopNumber, invoiceNumber, customerName, address, nop,
  /// signedAt, emailStatus }.
  stops          Json
  tenantId       String   @default("")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, completedAt])
  @@index([tenantId, driverId])
}

// ─── App Configuration ────────────────────────────────────────────────────
//
// Per-scope key/value config. Invoice folder, trip sheet folder and signature
// position are settings of ONE admin, not of the installation.

model AppConfig {
  tenantId  String   @default("")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([tenantId, key])
  @@index([tenantId])
}

// ─── Cloud Accounts (OneDrive / Google Drive OAuth) ───────────────────────
//
// One connection PER SCOPE per provider. accessToken and refreshToken are
// stored encrypted at rest (AES-256-GCM, see lib/crypto.ts) — the column type
// holds ciphertext, never a usable bearer token.

model CloudAccount {
  id                  String   @id @default(cuid())
  tenantId            String   @default("")
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  provider            String // "onedrive" | "gdrive"
  accountEmail        String?
  accountName         String?
  accessToken         String   @db.Text // encrypted
  refreshToken        String   @db.Text // encrypted
  tokenExpiry         DateTime
  driveId             String?
  folderPath          String? // trip sheet folder
  folderItemId        String? // trip sheet folder item ID
  invoiceFolderPath   String?
  invoiceFolderItemId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
}

// ─── Imported Files (Trip Sheet Cloud Folder Tracking) ────────────────────

model ImportedFile {
  id          String   @id @default(cuid())
  tenantId    String   @default("")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  filename    String
  folderPath  String
  importedAt  DateTime @default(now())
  tripSheetId String?
  status      String   @default("imported") // imported | failed | skipped

  // Scoped uniqueness — one ADMIN importing "route.csv" must not mark it
  // consumed for every other ADMIN.
  @@unique([tenantId, filename])
  @@index([tenantId])
  @@index([filename])
  @@index([importedAt])
}

// ─── Audit Log ────────────────────────────────────────────────────────────

enum AuditAction {
  UPLOAD
  SIGN
  LOGIN
  LOGOUT
  STATUS_CHANGE
  DRIVER_CREATE
  DRIVER_UPDATE
  DRIVER_DELETE
  CONFIG_UPDATE
  SCOPE_SWITCH
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  entity    String // trip_sheet | stop | driver | admin | config | scope
  entityId  String?
  userName  String?
  details   String?     @db.Text
  // Nullable by design: failed logins and other pre-session events have no
  // scope yet. Everything post-authentication MUST set it.
  tenantId  String?
  tenant    Tenant?     @relation(fields: [tenantId], references: [id])
  createdAt DateTime    @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([tenantId, createdAt])
}

// ─── Contacts ─────────────────────────────────────────────────────────────

enum ContactSource {
  MANUAL
  SPREADSHEET
  AUTO_CREATED
}

model Contact {
  id            String        @id @default(cuid())
  tenantId      String        @default("")
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  companyName   String
  contactPerson String?
  email         String?
  phone         String?
  altPhone      String?
  address       String?
  notes         String?
  source        ContactSource @default(MANUAL)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  stops         Stop[]

  // Composite-FK target so a Stop cannot reference a contact in another scope.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, companyName])
  @@index([tenantId, email])
  @@index([deletedAt])
}
