# ─── Signex Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit your .env file to version control.
# ───────────────────────────────────────────────────────────────────────────

# ─── Database ──────────────────────────────────────────────────────────────
# Two PostgreSQL connection strings. Getting these the right way round is the
# difference between the app scaling and it stalling under load.
#
# DATABASE_URL — the POOLED endpoint. Used by the application at runtime.
#   On Neon this is the host containing "-pooler". PgBouncer multiplexes many
#   serverless instances onto a few real Postgres backends, which is what makes
#   Vercel's scale-out safe. Pointing this at the direct endpoint exhausts
#   max_connections as soon as several branches are busy at once.
#
# DATABASE_URL_DIRECT — the DIRECT endpoint. Used by the Prisma CLI only
#   (migrate/db push). Migrations need a real session for advisory locks and
#   DDL, neither of which survives a transaction-mode pooler.

DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_DIRECT="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Optional. Per-instance pg pool ceiling; the pooler does the real fan-out, so
# this stays deliberately small. Defaults to 5.
DATABASE_POOL_MAX=5

# ─── Rate Limiting (Upstash Redis) ─────────────────────────────────────────
# Strongly recommended in production. Without these the limiter falls back to
# per-instance in-memory counters, which on Vercel means each serverless
# instance keeps its own — so the shared login limit is not actually shared.
#
# Create a database at https://console.upstash.com → Redis, then copy the
# "REST API" credentials (not the redis:// URL).
#
# Authenticated API traffic is limited PER SESSION, so a branch office behind a
# single NAT address gets one budget per person rather than one between them.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Session ───────────────────────────────────────────────────────────────
# REQUIRED — the app will not start without this.
# Generate a strong random secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

SESSION_SECRET="CHANGE_ME_GENERATE_A_RANDOM_SECRET"

# --- Token Encryption -----------------------------------------------------
# REQUIRED - the app will not start without this.
# Encrypts each ADMIN's OneDrive OAuth tokens at rest (AES-256-GCM). Must be
# 32 bytes of hex. Rotating it makes existing stored tokens undecryptable, so
# every ADMIN would have to reconnect their OneDrive.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

TOKEN_ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARACTERS"

# --- Tests ----------------------------------------------------------------
# Optional. Points the isolation test suite at a THROWAWAY database - the
# suite truncates every table, so never set this to a real database.
# Without it, tests/isolation.test.ts skips.

TEST_DATABASE_URL=

# ─── Invoice Folder ───────────────────────────────────────────────────────
# Path to local or shared network folder containing PDF invoices.
# Leave empty to use the default ./invoices folder.

INVOICE_FOLDER_PATH=

# ─── Trip Sheet Folder ────────────────────────────────────────────────────
# Path to folder containing trip sheet CSV/Excel files.
# Can also be set via the admin Settings page.

TRIP_SHEET_FOLDER_PATH=

# ─── Contacts / AI ───────────────────────────────────────────────────────
# Anthropic API key for AI-powered contact extraction (optional)

ANTHROPIC_API_KEY=

# ─── OneDrive (Microsoft Graph API) ──────────────────────────────────────
# Required for OneDrive cloud folder sync.
# Register an app at https://portal.azure.com → App registrations
# Redirect URI: https://your-app.vercel.app/api/auth/microsoft/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# ─── App URL ─────────────────────────────────────────────────────────────
# Used for constructing callback URLs. Set to your production domain.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email (SMTP) ────────────────────────────────────────────────────────
# Used for sending delivery notifications to contacts.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Signex Deliveries
COMPANY_NAME=Signex

# ─── Multi-Tenant ─────────────────────────────────────────────────────────
# Email address for the super admin account (first user created on setup)

SUPER_ADMIN_EMAIL=your@email.com
